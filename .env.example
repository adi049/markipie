# ---- MARKIPIE environment ----
# Copy to .env and load it (e.g. `set -a; . ./.env; set +a`) before `npm start`.
# Nothing here is required for local development except ADMIN_PASSWORD in production.

# Runtime
NODE_ENV=production            # enables Secure cookies + strict OTP behaviour
PORT=3000

# Admin credential (REQUIRED in production).
# If unset, the scrypt hash in data/.adminpass (created by `node migrate.js`) is used.
ADMIN_PASSWORD=change-me-to-something-long

# Google Drive (optional — gallery works with local media without it)
# Needs a Drive API key with access to the folders you sync.
# Server-side only: this value is NEVER sent to the browser.
GOOGLE_DRIVE_API_KEY=

# Face recognition tuning (optional).
# These are also editable in Admin -> Face Recognition; env values win on boot.
# Accuracy is never guaranteed — these only tune sensitivity.
FACE_MATCH_THRESHOLD=0.55      # lower = stricter matching
FACE_MIN_CONFIDENCE=0.4        # minimum detector confidence
FACE_MAX_PHOTOS=2000           # safety ceiling per scan

# SMS OTP (optional). Leave OTP_PROVIDER empty to skip the OTP step entirely;
# phone verification then relies on matching the number on the client/event record.
# The server NEVER fakes a successful OTP.
OTP_PROVIDER=                  # msg91 | twilio | (empty)

# --- MSG91 ---
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

# --- Twilio ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ---------------------------------------------------------------
# Not used by this project (listed because they appear in some specs):
#   MK_ADMIN_PASS      -> use ADMIN_PASSWORD
#   MK_API_PORT        -> use PORT
#   GOOGLE_DRIVE_SA_JSON -> service accounts are not implemented;
#                           this build authenticates with an API key.
#   FACE_ENGINE        -> the face engine is bundled (face-api.js,
#                           browser-side) and is not swappable by env.
# ---------------------------------------------------------------
